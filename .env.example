# Copy this file to .env and use credentials from a SANDBOX REST app.
# Keep the client secret out of browser code, screenshots, and chat.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# The server only calls https://api-m.sandbox.paypal.com.
# Live mode is deliberately unsupported.
PAYPAL_ENVIRONMENT=SANDBOX
PORT=4173

# Legacy Channel3 settings. The active server uses authored fixtures and ignores these.
# Use the sponsor/free-credit key; no paid catalog usage or automatic top-up.
CHANNEL3_API_KEY=
CHANNEL3_FREE_CREDITS_CONFIRMED=false
